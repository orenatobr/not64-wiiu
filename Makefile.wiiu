#---------------------------------------------------------------------------------
# not64 for Wii U (native, wut / Aroma)
#
#   make -f Makefile.wiiu          build executables/not64-wiiu.wuhb
#   make -f Makefile.wiiu test     run the host-side unit tests
#   make -f Makefile.wiiu clean
#
# Objects keep their directory under $(BUILD) because the emulator core has
# several files with the same name (r4300/tlb.c and gc_memory/tlb.c, ...).
#---------------------------------------------------------------------------------
.SUFFIXES:

ifeq ($(strip $(DEVKITPRO)),)
$(error "Please set DEVKITPRO in your environment. export DEVKITPRO=<path to>devkitPro")
endif

include $(DEVKITPRO)/wut/share/wut_rules

TARGET		:=	not64-wiiu
BUILD		:=	build_wiiu
EXECUTABLES	:=	executables

APP_NAME	:=	not64
APP_SHORTNAME	:=	not64
APP_AUTHOR	:=	extremscorner, Wii64 team, dborth (UI), orenatobr (Wii U port)
APP_ICON	:=	wiiu/meta/icon.png
APP_TV_SPLASH	:=	wiiu/meta/tv_splash.png
APP_DRC_SPLASH	:=	wiiu/meta/drc_splash.png

#---------------------------------------------------------------------------------
# Sources
#---------------------------------------------------------------------------------
APP_DIRS	:=	wiiu/source wiiu/source/menu wiiu/source/libgui wiiu/source/widgets \
			wiiu/source/utils wiiu/source/utils/sz \
			wiiu/source/drivers wiiu/source/drivers/wut wiiu/source/drivers/wut/shaders

DATA_DIRS	:=	wiiu/data/images_hd wiiu/data/sounds wiiu/data/fonts wiiu/data/lang

# Wii U specific glue for the emulator core lives in wiiu/source/core
CORE_GLUE_DIR	:=	wiiu/source/core
APP_DIRS	+=	$(CORE_GLUE_DIR)

# The original emulator core, shared with the Wii / GameCube builds.
# (gc_audio, gc_input, fileBrowser, ROM-Cache-MEM2, wii_vm, ... are replaced by
# the glue in wiiu/source/core.)
CORE_C_FILES	:=	main/timers.c main/md5.c main/rom_gc.c main/savestates_gc.c \
			r4300/r4300.c r4300/cop0.c r4300/special.c r4300/regimm.c r4300/exception.c \
			r4300/Invalid_Code.c r4300/Recomp-Cache-Heap.c r4300/ARAM-blocks.c r4300/interupt.c \
			r4300/cop1.c r4300/tlb.c r4300/cop1_w.c r4300/cop1_s.c r4300/cop1_d.c r4300/recomp.c \
			r4300/bc.c r4300/cop1_l.c r4300/pure_interp.c r4300/compare_core.c r4300/profile.c \
			r4300/ppc/MIPS-to-PPC.c r4300/ppc/Recompile.c r4300/ppc/Wrappers.c \
			r4300/ppc/FuncTree.c r4300/ppc/Register-Cache.c \
			gc_memory/tlb.c gc_memory/TLB-Cache-hash.c gc_memory/memory.c gc_memory/dma.c \
			gc_memory/n64_cic_nus_6105.c gc_memory/pif.c gc_memory/flashram.c \
			rsp_hle/alist.c rsp_hle/alist_audio.c rsp_hle/alist_naudio.c rsp_hle/alist_nead.c \
			rsp_hle/audio.c rsp_hle/cicx105.c rsp_hle/hle.c rsp_hle/hvqm.c rsp_hle/jpeg.c \
			rsp_hle/memory.c rsp_hle/mp3.c rsp_hle/musyx.c rsp_hle/re2.c rsp_hle/plugin.c

# The GX2 renderer for glN64_GX (docs/GX2_RENDERER.md)
include wiiu/gx2gx.mk

CFILES		:=	$(foreach d,$(APP_DIRS),$(wildcard $(d)/*.c)) $(CORE_C_FILES)
CPPFILES	:=	$(foreach d,$(APP_DIRS),$(wildcard $(d)/*.cpp)) $(GX2GX_CPPFILES) $(GLN64_CPPFILES)
CORE_OBJS	:=	$(addprefix $(BUILD)/,$(CORE_C_FILES:.c=.o))
GLUE_OBJS	:=	$(addprefix $(BUILD)/,$(patsubst %.c,%.o,$(wildcard $(CORE_GLUE_DIR)/*.c)))

PNGS		:=	$(foreach d,$(DATA_DIRS),$(wildcard $(d)/*.png))
OGGS		:=	$(foreach d,$(DATA_DIRS),$(wildcard $(d)/*.ogg))
PCMS		:=	$(foreach d,$(DATA_DIRS),$(wildcard $(d)/*.pcm))
TTFS		:=	$(foreach d,$(DATA_DIRS),$(wildcard $(d)/*.ttf))
LANGS		:=	$(foreach d,$(DATA_DIRS),$(wildcard $(d)/*.lang))

# binary assets become objects named <file>.<ext>.o with a <file>_<ext>.h header
BINDIR		:=	$(BUILD)/data
BINOBJS		:=	$(addprefix $(BINDIR)/,$(addsuffix .o,$(notdir $(PNGS) $(OGGS) $(PCMS) $(TTFS))) \
			$(patsubst %.lang,%.mo.o,$(notdir $(LANGS))))

OBJS		:=	$(addprefix $(BUILD)/,$(CFILES:.c=.o) $(CPPFILES:.cpp=.o)) $(BINOBJS)
DEPS		:=	$(OBJS:.o=.d)

#---------------------------------------------------------------------------------
# Flags
#---------------------------------------------------------------------------------
INCLUDES	:=	wiiu/source/core/compat wiiu/source $(BINDIR)

LIBDIRS		:=	$(PORTLIBS) $(WUT_ROOT) $(WUT_ROOT)/usr

FREETYPE_CFLAGS	:=	$(shell $(DEVKITPRO)/portlibs/ppc/bin/powerpc-eabi-pkg-config --cflags freetype2)
FREETYPE_LIBS	:=	$(shell $(DEVKITPRO)/portlibs/ppc/bin/powerpc-eabi-pkg-config --libs freetype2)

INCLUDE		:=	$(foreach d,$(INCLUDES),-I$(d)) $(foreach d,$(LIBDIRS),-I$(d)/include)
LIBPATHS	:=	$(foreach d,$(LIBDIRS),-L$(d)/lib)

WARNFLAGS	:=	-Wall -Wextra -Wno-unused-parameter
CFLAGS		:=	-g -O3 $(WARNFLAGS) $(MACHDEP) $(INCLUDE) $(FREETYPE_CFLAGS) \
			-DNOT64GX -D__WIIU__ -D__WUT__ -DHAVE_STDINT_H -DZLIB \
			-D_SZ_ONE_DIRECTORY -D_LZMA_IN_CB -D_LZMA_OUT_READ \
			-ffunction-sections -fdata-sections
# make TEST_INPUT=1: read scripted GamePad input from sd:/not64/test_input.txt (emulator smoke tests, never in releases)
ifdef TEST_INPUT
CFLAGS		+=	-DNOT64_TEST_INPUT
endif
CXXFLAGS	:=	$(CFLAGS) -std=c++17
# The core is classic C written for GCC 4: keep the GNU dialect, and let the
# few things modern GCC rejects stay warnings.
CORE_CFLAGS	:=	-g -O3 $(MACHDEP) $(INCLUDE) -std=gnu17 -fgnu89-inline -ffunction-sections -fdata-sections \
			-D__WIIU__ -D__WUT__ -DHW_RVL -DRELEASE -DNDEBUG -DMENU_V2 -DUSE_EXPANSION \
			-DPPC_DYNAREC -DUSE_RECOMP_CACHE -DGLN64_GX -DZLIB \
			-Wno-error=int-conversion -Wno-error=incompatible-pointer-types \
			-Wno-error=implicit-function-declaration -Wno-error=implicit-int
ASFLAGS		:=	-g $(MACHDEP)
LDFLAGS		:=	-g $(MACHDEP) $(RPXSPECS) -Wl,-Map,$(BUILD)/$(TARGET).map -Wl,--gc-sections

LIBS		:=	-lsmb2 -liconv -lwut -lmocha -ldvm -lpng -lmxml -lz -lvorbisidec -logg $(FREETYPE_LIBS)

# glN64 and the renderer see the GX compat headers, not the core's libogc shims
GX2GX_OBJS	:=	$(addprefix $(BUILD)/,$(GX2GX_CPPFILES:.cpp=.o))
GLN64_OBJS	:=	$(addprefix $(BUILD)/,$(GLN64_CPPFILES:.cpp=.o))
$(GX2GX_OBJS) $(GLN64_OBJS): CXXFLAGS := $(filter-out -Iwiiu/source/core/compat,$(CXXFLAGS)) $(addprefix -I,$(GX2GX_INCLUDES))
$(GX2GX_OBJS): CXXFLAGS += -D__WIIU__
$(GLN64_OBJS): CXXFLAGS += $(GX2GX_CFLAGS) $(GLN64_WARN) -fcommon
# glN64.cpp owns the definitions of the tables that the other glN64 files declare extern
$(BUILD)/glN64_GX/glN64.o: CXXFLAGS += -DMAINDEF

#---------------------------------------------------------------------------------
.PHONY: all clean test core
all: $(EXECUTABLES)/$(TARGET).wuhb

$(EXECUTABLES)/$(TARGET).wuhb: $(EXECUTABLES)/$(TARGET).rpx $(WUHB_DEPS)
	@mkdir -p $(dir $@)
	@echo packaging $(notdir $@) ...
	$(SILENTCMD)wuhbtool $< $@ $(WUHB_OPTIONS)

$(EXECUTABLES)/$(TARGET).rpx: $(EXECUTABLES)/$(TARGET).elf
$(EXECUTABLES)/$(TARGET).elf: $(OBJS)
	@mkdir -p $(dir $@) $(BUILD)
	@echo linking ... $(notdir $@)
	$(SILENTCMD)$(CXX) $(LDFLAGS) $(OBJS) $(LIBPATHS) $(LIBS) -o $@

# Every object may include a generated asset header, so the assets come first.
$(filter-out $(BINOBJS),$(OBJS)): | $(BINOBJS)

$(BUILD)/%.o: %.cpp
	@mkdir -p $(dir $@)
	@echo $<
	$(SILENTCMD)$(CXX) -MMD -MP $(CXXFLAGS) -c $< -o $@

$(BUILD)/%.o: %.c
	@mkdir -p $(dir $@)
	@echo $<
	$(SILENTCMD)$(CC) -MMD -MP $(CFLAGS) -c $< -o $@

# the original core is old code: silence its warnings. Our glue keeps them.
$(CORE_OBJS): CFLAGS := $(CORE_CFLAGS) -w
$(GLUE_OBJS): CFLAGS := $(CORE_CFLAGS) $(WARNFLAGS)

#---------------------------------------------------------------------------------
# Binary assets: bin2s writes the header (<name>_<ext>.h), the assembler the object
#---------------------------------------------------------------------------------
define bin2obj
	@mkdir -p $(dir $@)
	@echo $(notdir $<)
	$(SILENTCMD)bin2s -a 32 -H $(dir $@)$(subst .,_,$(notdir $<)).h $< | $(CC) -x assembler-with-cpp $(ASFLAGS) -c -o $@ -
endef

vpath %.png $(DATA_DIRS)
vpath %.ogg $(DATA_DIRS)
vpath %.pcm $(DATA_DIRS)
vpath %.ttf $(DATA_DIRS)
vpath %.lang $(DATA_DIRS)

$(BINDIR)/%.png.o: %.png
	$(bin2obj)
$(BINDIR)/%.ogg.o: %.ogg
	$(bin2obj)
$(BINDIR)/%.pcm.o: %.pcm
	$(bin2obj)
$(BINDIR)/%.ttf.o: %.ttf
	$(bin2obj)

# translations are compiled to .mo first (gettext)
.SECONDARY: $(patsubst %.mo.o,%.mo,$(filter %.mo.o,$(BINOBJS)))
$(BINDIR)/%.mo: %.lang
	@mkdir -p $(dir $@)
	@echo msgfmt $(notdir $<)
	@{ grep -q 'charset=' $< || printf 'msgid ""\nmsgstr "Content-Type: text/plain; charset=UTF-8\\n"\n\n'; tr -d '\r' < $<; } | msgfmt --no-hash -o $@ -
$(BINDIR)/%.mo.o: $(BINDIR)/%.mo
	$(bin2obj)

# compile only the emulator core and its Wii U glue (fast feedback while porting)
core: $(CORE_OBJS) $(GLUE_OBJS)

#---------------------------------------------------------------------------------
test:
	@$(MAKE) -C tests --no-print-directory

clean:
	@echo clean ...
	@rm -rf $(BUILD) $(EXECUTABLES)

-include $(DEPS)
