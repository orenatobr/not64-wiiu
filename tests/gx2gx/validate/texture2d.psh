; Functional equivalent of dborth's Texture2DShader pixel shader (texture * colour intensity).
; $MODE = "UniformRegister"
; $UNIFORM_VARS[0].name = "unf_blur_texture_direction"
; $UNIFORM_VARS[0].type = "vec3"
; $UNIFORM_VARS[0].count = 1
; $UNIFORM_VARS[0].offset = 0
; $UNIFORM_VARS[1].name = "unf_color_intensity"
; $UNIFORM_VARS[1].type = "vec4"
; $UNIFORM_VARS[1].count = 1
; $UNIFORM_VARS[1].offset = 4
; $SAMPLER_VARS[0].name = "sampl_texture"
; $SAMPLER_VARS[0].type = "sampler2D"
; $SAMPLER_VARS[0].location = 0
; $SQ_PGM_RESOURCES_PS.NUM_GPRS = 9
; $SQ_PGM_RESOURCES_PS.STACK_SIZE = 1
; $SPI_PS_IN_CONTROL_0.NUM_INTERP = 1
; $SPI_PS_IN_CONTROL_0.PERSP_GRADIENT_ENA = TRUE
; $SPI_PS_IN_CONTROL_0.BARYC_SAMPLE_CNTL = CENTERS_ONLY
; $NUM_SPI_PS_INPUT_CNTL = 1
; $SPI_PS_INPUT_CNTL[0].SEMANTIC = 0
; $SPI_PS_INPUT_CNTL[0].DEFAULT_VAL = 1

00 TEX:
0 SAMPLE R1, R0.xyxx, t0, s0
01 ALU:
1 x: MUL R1.x, R1.x, C1.x
  y: MUL R1.y, R1.y, C1.y
  z: MUL R1.z, R1.z, C1.z
  w: MUL R1.w, R1.w, C1.w
2 x: MOV R8.x, 0.0f
02 EXP_DONE: PIX0, R1.xyzw
END_OF_PROGRAM
